        <mxCell id="Jpw163OcqGP_omRILY5C-475" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;RMS Norm&lt;/h1&gt;&lt;p&gt;# B: # of batch&lt;br&gt;# L: sequence length&lt;br&gt;# D: dimension&lt;br&gt;&lt;/p&gt;&lt;p&gt;arg0: E [B, L, D]&lt;br&gt;return: E&#39; [B, L, D]&lt;br&gt;&lt;/p&gt;&lt;p&gt;for b in [0,B)&lt;br&gt;&amp;nbsp; for l in [0,L):&lt;br&gt;&amp;nbsp; &amp;nbsp; sum = 0&lt;br&gt;&amp;nbsp; &amp;nbsp; for d in [0,D):&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; sum += E[b,l,d] ^ 2&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; rms = (sum / D + eps) ^ 0.5&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; for d in [0,D):&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; E&#39;[b,l,d] = E[b,l,d] / rms&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=PT Mono;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="Jpw163OcqGP_omRILY5C-474">
