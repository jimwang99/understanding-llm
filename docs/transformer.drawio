        <mxCell id="Jpw163OcqGP_omRILY5C-344" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;RoPE&lt;/h1&gt;&lt;p&gt;arg0: qk [B,L,N,D]&lt;br&gt;arg1: cos [L,D/2]&lt;br&gt;arg2: sin [L,D/2]&lt;br&gt;return: qk&#39; [B,L,N,D]&lt;/p&gt;&lt;p&gt;for b in [0,B)&lt;br&gt;&amp;nbsp; for l in [0,L)&lt;br&gt;&amp;nbsp; &amp;nbsp; for n in [0,N)&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; for d in [0,D/2)&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i = qk[b,l,n,2*d];&amp;nbsp;r = qk[b,l,n,2*d+1]&lt;br&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; qk&#39;[b,l,n,2*d] = r * cos[l,d] + i * sin[l,d]&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; qk&#39;[b,l,n,2*d+1] = r * cos[l,d] - i * sin[l,d]&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=PT Mono;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="Jpw163OcqGP_omRILY5C-335">
          <mxGeometry x="40" y="360" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="Jpw163OcqGP_omRILY5C-369" value="KV Cache" style="swimlane;whiteSpace=wrap;html=1;fontFamily=PT Mono;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="840" y="-940" width="520" height="480" as="geometry">
            <mxRectangle x="160" y="-1080" width="520" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Jpw163OcqGP_omRILY5C-386" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Save in prefill stage&lt;/h1&gt;&lt;p&gt;# Lm: max sequence length&lt;br&gt;# Y: total number of layers&lt;br&gt;# y: current layer index&lt;br&gt;&lt;/p&gt;&lt;p&gt;arg0: kv [B,L,N*D]&lt;br&gt;return: buf [B,Y,Lm,N*D]&lt;br&gt;&lt;/p&gt;&lt;p&gt;for b in [0,B)&lt;br&gt;&amp;nbsp; for l in [0,L):&lt;br&gt;&amp;nbsp; &amp;nbsp; buf[b,y,l,:] = kv[b,l,:]&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=PT Mono;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="Jpw163OcqGP_omRILY5C-369">
          <mxGeometry x="40" y="40" width="440" height="200" as="geometry" />
        </mxCell>
        <mxCell id="Jpw163OcqGP_omRILY5C-393" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Append and load in generate stage&lt;br&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;# C: current cache size&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;arg0: kv [B,1,1,N*D]&lt;br&gt;arg1: buf [B,Y,Lm,N*D]&lt;br&gt;return: kv&#39; [B,1,C+1,N*D]&lt;/p&gt;&lt;p&gt;for b in [0,B)&lt;br&gt;&amp;nbsp; for l in [0,L):&lt;br&gt;&amp;nbsp; &amp;nbsp; buf[b,y,c+1,:] = kv[b,1,1,:]&lt;br&gt;&amp;nbsp; &amp;nbsp; for c in [0,C+1):&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; kv&#39;[b,1,c,:] = buf[b,y,c,:]&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=PT Mono;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="Jpw163OcqGP_omRILY5C-369">
