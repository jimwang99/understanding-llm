            <mxPoint x="240" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="LsSrs35LtCmljVc6e2sk-49" value="18 nodes in total&lt;div&gt;4x18 = 72 GPUs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=default;labelBackgroundColor=default;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="LsSrs35LtCmljVc6e2sk-50" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;All-to-all connections&lt;/h1&gt;&lt;div&gt;Extreme flexibility, extreme bandwidth, and extreme cost&lt;/div&gt;&lt;p&gt;1. If GPU #1 want to talk to GPU #n, it can utilize all its 18 connections to reach maximum bandwidth. But in this case, GPU #1 cannot talk to any other GPUs in parallel.&lt;/p&gt;&lt;p&gt;2. GPUs can talk to any other GPUs in the same system with only a single hop of switch.&lt;/p&gt;&lt;p&gt;3. Even in the same node, GPUs cannot talk to each other without going through the switch.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="1">
          <mxGeometry x="280" y="880" width="360" height="200" as="geometry" />
        </mxCell>
