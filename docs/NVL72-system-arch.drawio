        <mxCell id="LsSrs35LtCmljVc6e2sk-45" value="All-to-all connection&lt;div&gt;across all 18 nodes&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=default;labelBackgroundColor=default;strokeColor=none;fontStyle=1;fillColor=none;" vertex="1" parent="1">
